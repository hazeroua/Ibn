[configuration]

entry_symbol = "ibn_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/libibn.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libibn.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libibn.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libibn.linux.template_release.x86_64.so"
macos.debug.arm64 = "res://bin/libibn.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libibn.macos.template_release.arm64.dylib"
