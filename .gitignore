# Outils installés localement (recréés par Tools/installer.ps1)
/Tools/godot/
/Tools/_telechargements/
/Tools/outils.json

# Godot
/Game/.godot/
/Game/export/
*.translation

# C++ (GDExtension)
/Extensions/godot-cpp/
/Extensions/**/*.obj
/Extensions/**/*.o
/Extensions/**/*.lib
/Extensions/**/*.exp
/Extensions/**/*.pdb
/Extensions/**/*.ilk
/Extensions/.sconsign*.dblite
/Game/bin/*.dll

# Ressources en attente d'import
/Import/*
!/Import/.gitkeep

# Mesures, captures et vidéos générées
/Mesures/

# Divers
Thumbs.db
desktop.ini

# Environnement Python dédié (Tools/dependances.ps1)
/Tools/venv/

# Plugins Godot installés aux versions figées de Tools/versions.json
/Game/addons/

# Bibliothèques C++ compilées
/Game/bin/*.so
/Game/bin/*.exp
/Game/bin/*.lib
/Game/bin/*.pdb

# Ressources téléchargées automatiquement (manifestes dans Game/data/assets/)
/Game/assets/textures/polyhaven/

# Scènes générées par les constructeurs de Game/tools/builders/ (la source de vérité est le script et ses données)
/Game/world/sandbox/sandbox.tscn

# Versions exportées
/Build/

# Carte « collines » générée par Game/tools/builders/build_collines.gd
/Game/world/collines/collines.tscn
/Game/world/collines/terrain_data/
# Personnages 3D préparés par Scripts/Pipeline/importer-personnages.ps1 (manifeste : Game/data/assets/characters.json)
/Game/assets/characters/*/

# Scène générée de la vitrine du personnage
/Game/world/vitrine_personnage/vitrine_personnage.tscn
__pycache__/

# Sons libres téléchargés (manifeste Game/data/assets/sounds.json)
/Game/assets/sounds/
/Game/world/jeu/jeu.tscn
