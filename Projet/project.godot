; Projet Godot du reboot Terrain3D (ticket #63).
; Les réglages ci-dessous sont les valeurs de démarrage ; la configuration
; graphique et les commandes sont réappliquées par core/boot depuis data/config/.
config_version=5

[application]

config/name="Les Chemins d'Ibn Khaldoun"
config/version="0.1.0"
run/main_scene="res://core/boot/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="IbnKhaldoun"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/ibn.log"
file_logging/max_log_files=10
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/driver.windows="vulkan"
scaling_3d/mode=2
scaling_3d/scale=0.67
anti_aliasing/quality/msaa_3d=0
textures/vram_compression/import_etc2_astc=false
